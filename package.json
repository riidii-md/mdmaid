{
  "name": "mdmaid",
  "version": "0.1.17",
  "type": "module",
  "description": "Markdown + Mermaid made simple - A powerful markdown renderer with first-class Mermaid diagram support",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "bin": {
    "mdmaid": "bin/mdmaid.js"
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "exports": {
    ".": "./dist/lib/index.js",
    "./server": "./dist/server/index.js",
    "./cli": "./dist/cli/index.js",
    "./ssr": "./dist/core/mermaid-ssr.js",
    "./tui": "./dist/tui/index.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "npm run build && node --test",
    "dev": "tsc --watch",
    "test": "npm run check",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/tui/**/*.js' --test-coverage-include='dist/core/validation.js' --test-coverage-include='dist/core/mermaid-parser*.js'"
  },
  "keywords": [
    "markdown",
    "mermaid",
    "diagrams",
    "renderer",
    "cli",
    "neovim",
    "preview"
  ],
  "author": "Oleksandr Besan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riidii-md/mdmaid.git"
  },
  "dependencies": {
    "beautiful-mermaid": "^1.1.3",
    "chalk": "^5.6.2",
    "chokidar": "^3.5.3",
    "jsdom": "^26.1.0",
    "lowlight": "^3.3.0",
    "mermaid": "^11.12.2",
    "node-emoji": "^2.1.3",
    "remark": "^15.0.1",
    "remark-autolink-headings": "^7.0.1",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-slug": "^7.0.1",
    "string-width": "^7.2.0",
    "unist-util-visit": "^5.0.0",
    "wrap-ansi": "^9.0.2",
    "ws": "^8.14.2"
  },
  "peerDependencies": {
    "puppeteer": "^23.11.1"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/mdast": "^4.0.4",
    "@types/node": "^20.14.8",
    "@types/ws": "^8.5.8",
    "puppeteer": "^23.11.1",
    "typescript": "^5.5.2"
  }
}
